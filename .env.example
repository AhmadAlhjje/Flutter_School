# Student app configuration (bundled into the app — public values only, never secrets).

# Backend API address.
# Local development: http://localhost:4000 — every debug build runs `adb reverse`, so a phone
# connected by USB reaches the backend running on this laptop. Emulators work the same way.
# Release builds: https://api.your-domain.com (plain http is refused outside debug builds).
API_BASE_URL=http://localhost:4000
