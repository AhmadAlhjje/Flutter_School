<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: HTTPS only. The single cleartext exception is the loopback address used by
     the in-app server that feeds downloaded (still encrypted) videos to the player. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
