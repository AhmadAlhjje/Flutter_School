<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP so the app can reach a local development API
     (localhost through adb reverse, the emulator host 10.0.2.2 or a LAN address). Release builds use the HTTPS-only config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
